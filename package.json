{
	"name": "slidev-theme-russell",
	"version": "0.1.0",
	"description": "Slidev theme for the 'Informatica 2c' deck (flat, Zed-inspired look).",
	"type": "module",
	"keywords": [
		"slidev-theme",
		"slidev"
	],
	"engines": {
		"slidev": ">=53.0.0"
	},
	"dependencies": {
		"@fontsource/fira-code": "^5.3.0",
		"@fontsource/ia-writer-quattro": "^5.3.0"
	},
	"slidev": {
		"colorSchema": "both",
		"defaults": {
			"fonts": {
				"sans": "iA Writer Quattro",
				"mono": "Fira Code",
				"provider": "none"
			}
		}
	}
}
